*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets — never commit
.env
.env.*
secrets.json
*.pem
*.p12

# Generated by tools/embed-dev-secrets.py on each build. Contains baked .env values.
OmniRecorder/App/DevSecrets.swift

# Python (diarization-service, later phases)
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Editors
.vscode/
.idea/
*.swp
